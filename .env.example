# Google Fact Check Tools API (Google Cloud > APIs > "Fact Check Tools API" > Identifiants > Clé API)
GOOGLE_FACTCHECK_API_KEY=
# User-agent identifiant le projet avec un contact (exigence de conformité)
OBSERVATOIRE_USER_AGENT="ObservatoireParolePolitique/0.1 (+mailto:contact@example.org)"
# Débit par domaine, en secondes
CRAWL_DELAY_SECONDS=2
